APP_ENV=development
APP_NAME=Constellink API
FRONTEND_ORIGIN=http://localhost:5173

# Start with memory; switch to supabase after the offline flow passes.
REPOSITORY_BACKEND=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Start with fake; switch to openai_compatible after adding credentials.
LLM_BACKEND=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=fake-zhijing-v1
LLM_TIMEOUT_SECONDS=45
LLM_JSON_MODE=false

# Start with demo; switch to zhihu only after receiving an Access Secret.
CONTENT_PROVIDER=demo
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_APP_ID=618
ZHIHU_OAUTH_APP_KEY=
# Must be public HTTPS and exactly match the callback registered with Zhihu.
# Render derives https://<service>.onrender.com/auth/callback automatically when blank.
ZHIHU_OAUTH_REDIRECT_URI=
# Temporary hackathon compatibility for callbacks that may omit state.
# This is browser-cookie-bound but is not a production-grade replacement for OAuth state.
ZHIHU_OAUTH_ALLOW_MISSING_STATE=false
# Keep true for every real OAuth deployment. Local preview intentionally disables login.
OAUTH_COOKIE_SECURE=true
ZHIHU_API_BASE_URL=https://developer.zhihu.com/api/v1

MAX_SOURCES=12
MAX_SOURCE_CHARS=1200
EXTRACT_CONCURRENCY=4
USE_PRECOMPUTED_DEMO=false
PROMPT_VERSION=v1
